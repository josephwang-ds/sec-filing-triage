# Copy this file to .env, fill only the providers you use, then run:
#   set -a; source .env; set +a
# Never commit the populated .env file.

COMPANY_LENS_LLM_PROVIDER=openai

OPENAI_API_KEY=
# Vercel Ask function only. Public origin check; leave empty for local static preview.
# The Origin header is set by the browser and trivially forged by anything else,
# so treat this as tidiness, not as the spending control. That is the budget below.
# COMPANY_LENS_ASK_ORIGIN=https://lens.josephjwang.com
#
# Hard ceiling on paid provider calls per UTC day across the whole endpoint.
# COMPANY_LENS_ASK_DAILY_BUDGET=300
#
# Shared counters for the budget and the per-IP window. Without these the
# counters live inside one serverless instance: they reset on cold start and
# each concurrent instance keeps its own, so the real allowance is the limit
# times however many are live. Any Redis-compatible REST endpoint works
# (Upstash, Vercel KV). Backend-only -- never expose in browser configuration.
# COMPANY_LENS_ASK_KV_REST_URL=
# COMPANY_LENS_ASK_KV_REST_TOKEN=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional source-linked company and market headline refresh.
# Stored only in the refresh job's environment; never expose this in browser JavaScript.
FINNHUB_API_KEY=

# Optional model overrides. Production Ask AI must set COMPANY_LENS_OPENAI_MODEL
# explicitly; do not rely on the function default.
# COMPANY_LENS_OPENAI_MODEL=gpt-5.6-terra
# COMPANY_LENS_DEEPSEEK_MODEL=deepseek-v4-flash
# COMPANY_LENS_QWEN_MODEL=qwen3.8-max
# COMPANY_LENS_ANTHROPIC_MODEL=claude-sonnet-5
# COMPANY_LENS_GEMINI_MODEL=gemini-3.6-flash
